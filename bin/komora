#!/usr/bin/env bash
# komora: a thin wrapper around the openshell CLI. Scaffold: #15. Spec: #14.
set -euo pipefail

KOMORA_DRY_RUN=0
KOMORA_CWD="$PWD"
KOMORA_IMAGE="${KOMORA_IMAGE:-ghcr.io/nvidia/openshell-community/sandboxes/base:latest}"
KOMORA_PROFILE="${KOMORA_PROFILE:-default}"

# Path inside the sandbox where the repo volume and profile volume land.
# /sandbox is the sandbox user's home in the community base image (#18,
# verified live).
SANDBOX_REPO_DIR="/sandbox/repo"
SANDBOX_CONFIG_DIR="/sandbox/.claude"

# CLAUDE_CONFIG_DIR is required, not optional (#29, verified live).
#
# #18 recorded that the profile volume "mounts exactly where the agent looks
# for its config, no environment override required." That was half true and
# the missing half loses the account binding: Claude Code splits its state
# across ~/.claude/ (credential, sessions, history — inside the mount) *and*
# ~/.claude.json (oauthAccount, userID — a *sibling* of the mount, so in the
# container's ephemeral layer). Destroy the sandbox and .claude.json dies
# with it.
#
# The failure is nastier than a plain re-login: the credential is still
# valid, so a fresh chamber authenticates fine but has lost which account it
# belongs to, and presents onboarding as though login never happened. Another
# "looks like komora's bug, isn't" case (cf. the 401 class #30 deletes).
#
# Setting CLAUDE_CONFIG_DIR to the mount relocates *everything*, .claude.json
# included, into the volume — verified by destroying a sandbox and landing an
# authenticated agent in a fresh one with no re-login and no warning.
SANDBOX_CONFIG_ENV="CLAUDE_CONFIG_DIR=$SANDBOX_CONFIG_DIR"

# The egress policy komora owns and passes on every create (#29, #31). It
# lives as an embedded heredoc (render_policy, at the foot of this file) so
# komora stays a single self-contained script — no data file shipping
# alongside it. On each create komora renders the heredoc to a temp file and
# points --policy at that path; OpenShell needs a file, so komora materialises
# one transiently rather than keeping one at rest (#31).
#
# KOMORA_POLICY overrides the heredoc entirely: set it to a path and komora
# passes that file straight through, skipping the render. That is the seam
# that makes the policy testable without editing the script, and the one #29's
# live verification leaned on.
#
# Passing --policy is not optional: without it, komora silently inherits
# whatever the image ships, so an image update can change komora's security
# posture without anyone deciding to (#29).
KOMORA_POLICY="${KOMORA_POLICY:-}"

# Temp policy files materialise_policy creates, cleaned up on exit (#31).
KOMORA_POLICY_TMPS=()

# The resolved --policy path for the current create. resolve_policy_path sets
# it in place (rather than printing) so materialise_policy's cleanup trap and
# temp file both live in komora's shell, not a command-substitution subshell
# that would exit — and delete the file — before the create reads it (#31).
KOMORA_POLICY_PATH=""

usage() {
  cat >&2 <<'EOF'
usage: komora [--dry-run] [--cwd DIR] <command> [args...]

commands:
  run [owner/repo]
              create or resume the sandbox for a repo and land in the agent
              (also the default when no command is given)
  ls          list komora sandboxes and volumes
  stop        stop a running sandbox
  rm          remove a sandbox (or, with intent, a volume)
  shell [owner/repo]
              same as run, but open a shell instead of the agent
  id [owner/repo]
              resolve and print the repo id and slug this invocation means

  --dry-run   print podman/openshell invocations instead of running them
EOF
}

# --- the dry-run seam: every external invocation goes through `plan`, which
# either prints the command (one per line, args in call order) or execs it.
# This is the seam every later ticket's tests assert against (#14).
plan() {
  if [[ "$KOMORA_DRY_RUN" -eq 1 ]]; then
    local line="" arg
    for arg in "$@"; do
      printf -v arg '%q' "$arg"  # shell-quote in place, not append
      line+="${line:+ }${arg}"
    done
    printf '%s\n' "$line"
  else
    "$@"
  fi
}

# Maps an owner/repo (or any string) to a Podman/OpenShell-safe volume slug:
# lowercase, [a-z0-9-] only. Not injective by design (#14, #16) — collision
# detection against existing volumes is the caller's job, not this function's.
slugify() {
  local s="${1,,}"
  s="${s//[^a-z0-9]/-}"
  printf '%s' "$s"
}

cmd_ls() {
  plan podman volume ls --filter "label=komora"
  plan podman ps --all --filter "label=komora"
}

# Reads the sandbox user's uid out of the image's own /etc/passwd at run time
# (#14, #17). Never hardcoded: it is 998 in the current community base image
# and would differ in a custom one. `--entrypoint sh` is required — the image's
# own entrypoint is /bin/bash, which would otherwise swallow "sh" as its argv
# rather than exec it.
resolve_sandbox_uid() {
  podman run --rm --entrypoint sh "$KOMORA_IMAGE" -c 'getent passwd sandbox | cut -d: -f3'
}

# Creates a named volume if it does not already exist. `podman volume create`
# is not itself idempotent — it errors on an existing name — so existence is
# checked first (#17 acceptance: creating is idempotent).
ensure_volume() {
  local vol="$1"; shift
  podman volume exists "$vol" 2>/dev/null && return 0
  plan podman volume create "$@" "$vol"
}

# Primes a volume so the sandbox uid can write it. Podman's first-mount
# auto-chown of an empty named volume targets container root, not the sandbox
# uid OpenShell's supervisor setuid()s down to — so an unprimed volume mounts
# but is not writable by the agent. Priming must *write* as that uid; a run
# that only mounts does not trigger the chown (#14, #17). Idempotent: touching
# an existing .keep neither errors nor destroys other content in the volume.
prime_volume() {
  local vol="$1" uid="$2"
  plan podman run --rm --user "${uid}:${uid}" --entrypoint sh \
    -v "${vol}:/x" "$KOMORA_IMAGE" -c 'touch /x/.keep'
}

# Creates and primes both persistent volumes for a repo id + slug + profile
# name. The profile volume is primed but never seeded with a credential —
# login happens inside the chamber, not staged from the host (#30). Sets the
# caller's REPO_VOL / PROFILE_VOL / SANDBOX_UID globals rather than printing
# a return value — plan's dry-run trace already owns stdout here, so a
# printed return line would be indistinguishable from trace output
# (#14, #17, #18).
#
# The komora.repo label carries the full repo_id (owner/repo), not the
# slug: check_slug_collision reads it back to tell two different repo_ids
# that happen to slug identically apart. Storing the slug there instead
# would make that check compare a slug against itself and never detect a
# real collision — the bug that shipped with #16/#17 and only surfaced once
# #18 wired cmd_run's create-then-resume path end to end against this
# exact label (verified live: a second `komora run arteven/komora` refused
# itself as a "collision" with its own volume).
ensure_repo_and_profile_volumes() {
  local repo_id="$1" slug="$2" profile="$3"
  REPO_VOL="komora-repo-${slug}"
  PROFILE_VOL="komora-profile-${profile}"

  SANDBOX_UID="$(resolve_sandbox_uid)"

  ensure_volume "$REPO_VOL" --label "komora" --label "komora.repo=${repo_id}"
  ensure_volume "$PROFILE_VOL" --label "komora" --label "komora.profile=${profile}"

  prime_volume "$REPO_VOL" "$SANDBOX_UID"
  prime_volume "$PROFILE_VOL" "$SANDBOX_UID"
}

# komora derives no credential from the host (#30). The profile volume starts
# empty (but for priming) and the developer logs in *inside* the chamber; the
# credential lives only in that volume from then on. Claude Code already
# handles an unauthenticated start — it prompts for /login — so komora runs no
# detection and offers no `komora auth` command.
#
# This deletes the whole `401 OAuth access token has been revoked` failure
# class that staging from the host bought: there is no host copy to go stale,
# no host config dir to resolve wrong, and no restage-on-resume subtlety. Note
# this is the opposite direction from SANDBOX_CONFIG_ENV, which komora still
# sets to keep the account binding (~/.claude.json) *inside* the volume —
# komora imports no host state, but still pins where the tool writes its own.

cmd_stop() {
  echo "komora: stop not yet implemented" >&2
  return 1
}

cmd_rm() {
  echo "komora: rm not yet implemented" >&2
  return 1
}

# #19: a shell instead of the agent. A sandbox created via `komora shell`
# and one created via `komora run` are indistinguishable and equally
# resumable by either subcommand — only the final command differs.
cmd_shell() {
  local repo_id slug
  read -r repo_id slug < <(resolve_repo_id "${1:-}") || return 1
  # -l for a login shell: a bare `exec bash` skips /etc/profile and
  # ~/.bash_profile, silently dropping whatever PATH/prompt setup the image
  # provides — the opposite of "feels native" (#19).
  launch_into "$repo_id" "$slug" "bash -l"
}

# Parses an `origin` remote URL into owner/repo. Handles both forms git
# actually produces: SSH shorthand (git@host:owner/repo.git) and HTTPS
# (https://host/owner/repo.git), with an optional trailing ".git" (#16).
parse_remote_url() {
  local url="$1" path
  case "$url" in
    git@*:*)   path="${url#*:}" ;;
    https://*) path="${url#https://*/}" ;;
    http://*)  path="${url#http://*/}" ;;
    *) return 1 ;;
  esac
  path="${path%.git}"
  path="${path%/}"
  [[ "$path" == */* ]] || return 1
  printf '%s' "$path"
}

# Derives owner/repo from `git remote get-url origin` in KOMORA_CWD, if that
# directory is inside a clone with an origin remote.
derive_repo_id() {
  local url
  url="$(git -C "$KOMORA_CWD" remote get-url origin 2>/dev/null)" || return 1
  parse_remote_url "$url"
}

# Reads the owner/repo recorded on an existing repo volume's komora.repo
# label, if that volume exists. Empty output (not failure) if it doesn't —
# "no volume yet" and "lookup error" are both "nothing to collide with".
existing_volume_repo() {
  local vol="$1"
  podman volume inspect --format '{{ index .Labels "komora.repo" }}' "$vol" 2>/dev/null || true
}

# Refuses a slug collision: two different owner/repo values that slug to the
# same volume name would otherwise silently share one repo volume (#14, #16).
check_slug_collision() {
  local repo_id="$1" slug="$2"
  local vol="komora-repo-${slug}"
  local existing; existing="$(existing_volume_repo "$vol")"

  if [[ -n "$existing" && "$existing" != "$repo_id" ]]; then
    echo "komora: slug collision on '$slug'" >&2
    echo "  '$repo_id' and '$existing' both slug to '$slug'" >&2
    echo "  refusing to share the same volume between different repos" >&2
    return 1
  fi
}

# Resolves the repo id (owner/repo) this invocation means: a positional
# argument if given, else derived from `git remote get-url origin` (#16).
# Prints "repo_id slug" on success — the shared seam `cmd_id` and `cmd_run`
# both build on.
resolve_repo_id() {
  local repo_id="${1:-}"

  if [[ -z "$repo_id" ]]; then
    repo_id="$(derive_repo_id)" || {
      echo "komora: no repo given and not in a host clone" >&2
      echo "  pass an explicit owner/repo, or run inside a clone with an 'origin' remote" >&2
      return 1
    }
  fi

  local slug; slug="$(slugify "$repo_id")"
  check_slug_collision "$repo_id" "$slug" || return 1

  printf '%s %s\n' "$repo_id" "$slug"
}

cmd_id() {
  local repo_id slug
  read -r repo_id slug < <(resolve_repo_id "${1:-}") || return 1

  echo "repo: $repo_id"
  echo "slug: $slug"
}

# The sandbox name for a repo slug. Deterministic and profile-independent, so
# create-or-resume is a name lookup: `openshell sandbox create --name` already
# refuses a duplicate name (verified live), which is what gives komora the
# one-live-sandbox-per-repo-volume guarantee (#14, #18) without machinery of
# its own.
#
# `komora-<slug>` would be the readable choice, but OpenShell's server
# enforces a hard 19-char cap on sandbox (and workspace, and service) names
# (MAX_ROUTABLE_NAME_LEN, crates/openshell-server/src/grpc/mod.rs) — a limit
# #14 never accounted for, and one `komora-arteven-komora` already exceeds
# (verified live: "name exceeds maximum length (21 > 19)"). A short hash of
# the slug fits comfortably (`komora-` + 10 hex chars = 17) and stays
# deterministic; the human-readable slug survives as the `komora.slug` label
# for `sandbox get`/`list` to display instead.
sandbox_name() {
  local slug="$1" hash
  hash="$(printf '%s' "$slug" | sha256sum | cut -c1-10)"
  printf 'komora-%s' "$hash"
}

# True (exit 0) if a sandbox by this name already exists, whether Ready,
# Stopped, or otherwise — `sandbox get` fails with "sandbox not found" only
# when there is truly nothing there (#18, verified live).
sandbox_exists() {
  openshell sandbox get "$1" >/dev/null 2>&1
}

# The driver-config-json for `openshell sandbox create`: both volumes
# explicit read_only:false, per the Podman driver default of
# read_only:true (#14, #18 — the correction verified against
# crates/openshell-driver-podman/src/container.rs). Compact JSON on one
# line, since it travels as a single CLI argument.
driver_config_json() {
  local repo_vol="$1" profile_vol="$2"
  printf '{"podman":{"mounts":[{"type":"volume","source":"%s","target":"%s","read_only":false},{"type":"volume","source":"%s","target":"%s","read_only":false}]}}' \
    "$repo_vol" "$SANDBOX_REPO_DIR" "$profile_vol" "$SANDBOX_CONFIG_DIR"
}

# The in-sandbox command for a first-time launch: clone the repo into the
# (primed, empty-but-for-.keep) repo volume, then hand off to whatever final
# command the caller wants running (the agent, or a shell — #19). `rm -f
# .keep` clears the priming marker that would otherwise make `git clone`'s
# target look non-empty and refuse (#18, verified live).
launch_command() {
  local repo_id="$1" final="$2" dir="$SANDBOX_REPO_DIR"
  printf 'if [ ! -d %s/.git ]; then rm -f %s/.keep; git clone https://github.com/%s.git %s; fi; cd %s && exec env %s %s' \
    "$dir" "$dir" "$repo_id" "$dir" "$dir" "$SANDBOX_CONFIG_ENV" "$final"
}

# Resolves the --policy path for a create, setting the KOMORA_POLICY_PATH
# global (not printing it). The global matters: materialise_policy registers an
# EXIT trap to clean up the temp file, and a trap set inside a command
# substitution fires when that *subshell* exits — which would delete the file
# before `openshell sandbox create` ever reads it. Setting a global keeps both
# the trap and the file alive in komora's own shell until komora itself exits,
# after the create has run. This is the same set-a-global-not-print discipline
# ensure_repo_and_profile_volumes already follows, for the same reason.
#
# Two modes (#31):
#
#   - KOMORA_POLICY set  -> use that path, skipping the heredoc. The override
#     is a path OpenShell must be able to read, so a missing file is a hard
#     refusal: falling back to the image default would present as a working
#     chamber on a weaker posture than komora committed to (#29). Loud failure
#     is the whole value of owning the policy.
#
#   - KOMORA_POLICY unset -> render the embedded heredoc to a temp file. With
#     no shipped file there is nothing to be *missing*; the refusal now guards
#     the write instead (materialise_policy).
resolve_policy_path() {
  if [[ -n "$KOMORA_POLICY" ]]; then
    if [[ ! -f "$KOMORA_POLICY" ]]; then
      echo "komora: policy file not found at $KOMORA_POLICY" >&2
      echo "  KOMORA_POLICY points at a file komora cannot read" >&2
      echo "  unset it to use the embedded policy, or fix the path" >&2
      return 1
    fi
    KOMORA_POLICY_PATH="$KOMORA_POLICY"
    return 0
  fi
  materialise_policy
}

# Writes the embedded policy heredoc to a fresh temp file, setting
# KOMORA_POLICY_PATH to it. A new mktemp each call, under $TMPDIR (not a fixed
# path), cleaned up on exit by a trap this registers (#31). The refusal guards
# the *write*: an unwritable temp dir or an empty render — a heredoc that
# somehow produced nothing — is a hard failure for the same reason a missing
# override is, since `--policy` on an empty file is not the posture komora
# committed to.
materialise_policy() {
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/komora-policy.XXXXXX")" || {
    echo "komora: could not create a temp file for the egress policy" >&2
    echo "  check that ${TMPDIR:-/tmp} exists and is writable" >&2
    return 1
  }
  # Track the file for cleanup and arm the EXIT trap. Re-arming with the same
  # handler is idempotent — komora sets no other EXIT trap — and the array
  # means a second materialise in one process still gets both files removed.
  KOMORA_POLICY_TMPS+=("$tmp")
  trap 'komora_cleanup_policy_tmps' EXIT

  render_policy > "$tmp" || {
    echo "komora: failed to write the embedded egress policy to $tmp" >&2
    return 1
  }
  if [[ ! -s "$tmp" ]]; then
    echo "komora: the embedded egress policy rendered empty" >&2
    echo "  refusing to create a sandbox on an empty --policy file" >&2
    return 1
  fi
  KOMORA_POLICY_PATH="$tmp"
}

# Removes every temp policy file materialise_policy created this run. Safe to
# run with none pending (the array may be unset under set -u).
komora_cleanup_policy_tmps() {
  local f
  for f in "${KOMORA_POLICY_TMPS[@]:-}"; do
    [[ -n "$f" ]] && rm -f "$f"
  done
}

# Shared create-or-resume path for both cmd_run and cmd_shell (#14, #18,
# #19). The agent and a shell need identical volumes, priming, and collision
# handling — only the final command exec'd inside the sandbox varies, so
# that's the one thing parameterized here.
launch_into() {
  local repo_id="$1" slug="$2" final="$3"

  local name; name="$(sandbox_name "$slug")"

  if sandbox_exists "$name"; then
    echo "komora: resuming sandbox '$name' for $repo_id" >&2
    # No credential staging on resume (#30): the credential lives in the
    # profile volume, written by an in-chamber login, and the volume outlives
    # the sandbox — so a resumed sandbox is already authenticated with nothing
    # for komora to restage. The clone already exists by construction (a
    # sandbox only ever gets created after cloning), so resuming just lands in
    # it and hands off.
    plan openshell sandbox exec --name "$name" --tty -- sh -c "cd $SANDBOX_REPO_DIR && exec env $SANDBOX_CONFIG_ENV $final"
    return
  fi

  local REPO_VOL PROFILE_VOL SANDBOX_UID
  ensure_repo_and_profile_volumes "$repo_id" "$slug" "$KOMORA_PROFILE"

  echo "komora: creating sandbox '$name' for $repo_id" >&2
  # Label values reject '/' (verified live: "label value contains invalid
  # characters"), which rules out storing the raw owner/repo. The slug is
  # already label-safe ([a-z0-9-]+) and, combined with the one-sandbox-per-
  # slug guarantee, is enough to identify the sandbox back to its repo.
  #
  # --tty forces a PTY rather than relying on create's auto-detection, to
  # match sandbox exec's forced --tty on the resume path above (#19) — full
  # terminal fidelity (resize, Ctrl-C, truecolor) should not depend on
  # whether stdin happens to look like a terminal on first launch.
  # Reset then resolve into the *global* KOMORA_POLICY_PATH — not a local. The
  # trap materialise_policy registers and the file it writes have to outlive
  # this call, so the value it hands back must live in komora's own shell (see
  # resolve_policy_path). A `local` here would work only by accident of dynamic
  # scope and would contradict that rationale.
  KOMORA_POLICY_PATH=""
  resolve_policy_path || return 1

  plan openshell sandbox create --name "$name" --tty \
    --label "komora=true" --label "komora.slug=${slug}" \
    --policy "$KOMORA_POLICY_PATH" \
    --driver-config-json "$(driver_config_json "$REPO_VOL" "$PROFILE_VOL")" \
    -- sh -c "$(launch_command "$repo_id" "$final")"
}

# Slice 1 (#18): one command lands you in an authenticated agent session.
# Re-running against the same repo resumes the existing sandbox instead of
# creating a second one.
cmd_run() {
  local repo_id slug
  read -r repo_id slug < <(resolve_repo_id "${1:-}") || return 1
  launch_into "$repo_id" "$slug" "claude"
}

# Renders the embedded egress policy to stdout — the single frozen copy of the
# base image's /etc/openshell/policy.yaml plus komora's one delta (#29, #31).
#
# VENDORED, NOT INHERITED, and now EMBEDDED rather than shipped: this heredoc
# is where the vendored copy lives (#31). The provenance header and re-vendor
# recipe ride inside it so re-vendoring stays a diff, not archaeology — the
# recipe now diffs the image's file against `komora --render-policy`, this
# function's output, not against a repo file that no longer exists.
#
# A quoted heredoc (<<'KOMORA_POLICY_EOF'): the policy carries `**` globs and
# backtick/backslash characters in its comments that a plain heredoc would try
# to expand or mangle. Nothing here is meant to be interpolated.
render_policy() {
  cat <<'KOMORA_POLICY_EOF'
# SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# ---------------------------------------------------------------------------
# VENDORED, NOT INHERITED. komora owns this file (#29).
#
# Provenance — re-vendor by diffing a fresh copy against this one:
#   image:  ghcr.io/nvidia/openshell-community/sandboxes/base:latest
#   digest: sha256:aeef1c63f00e2913ea002ccb3aaf925f338b5c5d70e63576f0d95c16a138044e
#   path:   /etc/openshell/policy.yaml
#   as of:  2026-08-05, openshell 0.0.93
#
#   podman run --rm --entrypoint sh \
#     ghcr.io/nvidia/openshell-community/sandboxes/base:latest \
#     -c 'cat /etc/openshell/policy.yaml' > /tmp/base-policy.yaml
#   # This copy no longer ships as a file — it is the render_policy heredoc in
#   # bin/komora (#31). Diff against its rendered output, not a repo file:
#   bin/komora --render-policy > /tmp/komora-policy.yaml
#   diff /tmp/base-policy.yaml /tmp/komora-policy.yaml
#
# Why the whole file and not a delta: `--policy` fully REPLACES the built-in
# default — it does not merge (#29, verified empirically against 0.0.93; the
# OpenShell docs do not state this either way). A delta-only file does not
# loosen the default, it silently strips it, and the result presents as a
# broken chamber rather than a policy mistake.
#
# The cost: upstream policy changes do not reach komora's chambers until
# someone re-vendors. This is the most expensive coupling to OpenShell komora
# has taken on. Accepted deliberately — the cheap alternative (a custom
# `github` provider profile) was tested and composes nothing (#22).
#
# komora's deltas from the base, each citing its ticket — search "komora #":
#   - github_ssh_over_https: git-receive-pack write rule enabled (#22)
#
# Note the policy gates (binary, endpoint) PAIRS, not endpoints. Allowing a
# host is not enough if the binary dialling it is off that policy's binary
# list. Expect this on every addition.
# ---------------------------------------------------------------------------

version: 1

# --- Sandbox setup configuration (queried once at startup) ---

filesystem_policy:
  include_workdir: true
  read_only:
    - /usr
    - /lib
    - /proc
    - /dev/urandom
    - /app
    - /etc
    - /var/log
  read_write:
    - /sandbox
    - /tmp
    - /dev/null

landlock:
  compatibility: best_effort

process:
  run_as_user: sandbox
  run_as_group: sandbox

# --- Network policies (queried per-CONNECT request) ---
#
# Each named policy maps a set of allowed (binary, endpoint) pairs.
# Binary identity is resolved via /proc/net/tcp inode lookup + /proc/{pid}/exe.
# Ancestors (/proc/{pid}/status PPid walk) and cmdline paths are also matched.
# SHA256 integrity is enforced in Rust via trust-on-first-use, not here.

network_policies:
  claude_code:
    name: claude-code
    endpoints:
      - { host: api.anthropic.com, port: 443, protocol: rest, enforcement: enforce, access: full, tls: terminate }
      - { host: statsig.anthropic.com, port: 443 }
      - { host: sentry.io, port: 443 }
      - { host: raw.githubusercontent.com, port: 443 }
      - { host: platform.claude.com, port: 443 }
    binaries:
      - { path: /usr/local/bin/claude }
      - { path: /usr/bin/node }

  github_ssh_over_https:
    name: github-ssh-over-https
    endpoints:
      - host: github.com
        port: 443
        protocol: rest
        tls: terminate
        enforcement: enforce
        rules:
          # Git Smart HTTP read-only: allow clone, fetch, pull
          # Discovery (query string is included in path matching)
          - allow:
              method: GET
              path: "/**/info/refs*"
          # Data transfer for reads (all repos)
          - allow:
              method: POST
              path: "/**/git-upload-pack"
          # Data transfer for writes — komora #22 (git push).
          # Shipped commented out upstream; komora enables it. This is the
          # only delta from the vendored base policy. The credential is not
          # here: OpenShell's builtin `github` provider injects a PAT as a
          # bearer header at the proxy, so the chamber holds no token (#9).
          - allow:
              method: POST
              path: "/**/git-receive-pack"
    binaries:
      - { path: /usr/bin/git }

  nvidia_inference:
    name: nvidia-inference
    endpoints:
      - { host: integrate.api.nvidia.com, port: 443 }
    binaries:
      - { path: /usr/bin/curl }
      - { path: /bin/bash }
      - { path: /usr/local/bin/opencode }

  # --- GitHub REST API (read-only) ---
  github_rest_api:
    name: github-rest-api
    endpoints:
      - host: api.github.com
        port: 443
        protocol: rest
        tls: terminate
        enforcement: enforce
        access: read-only
    binaries:
      - { path: /usr/local/bin/claude }
      - { path: /usr/bin/gh }

  # --- GitHub Copilot API ---
  # Endpoints from https://docs.github.com/en/copilot/reference/copilot-allowlist-reference
  copilot:
    name: copilot
    endpoints:
      # Auth and user management
      - { host: github.com, port: 443 }
      - { host: api.github.com, port: 443 }
      # Copilot API (subscription-tier routing)
      - { host: api.githubcopilot.com, port: 443, protocol: rest, enforcement: enforce, access: read-write }
      - { host: api.individual.githubcopilot.com, port: 443, protocol: rest, enforcement: enforce, access: read-write }
      - { host: api.business.githubcopilot.com, port: 443, protocol: rest, enforcement: enforce, access: read-write }
      - { host: api.enterprise.githubcopilot.com, port: 443, protocol: rest, enforcement: enforce, access: read-write }
      # Model proxy
      - { host: copilot-proxy.githubusercontent.com, port: 443, protocol: rest, enforcement: enforce, access: read-write }
      # Telemetry, feature flags, updates
      - { host: origin-tracker.githubusercontent.com, port: 443 }
      - { host: telemetry.enterprise.githubcopilot.com, port: 443 }
      - { host: default.exp-tas.com, port: 443 }
      - { host: release-assets.githubusercontent.com, port: 443 }
    binaries:
      - { path: /usr/bin/copilot }
      - { path: "/usr/lib/node_modules/@github/copilot/node_modules/@github/**/copilot" }

  pypi:
    name: pypi
    endpoints:
      - { host: pypi.org, port: 443 }
      - { host: files.pythonhosted.org, port: 443 }
      # uv python install downloads from python-build-standalone on GitHub
      - { host: github.com, port: 443 }
      - { host: objects.githubusercontent.com, port: 443 }
      # uv resolves python-build-standalone release metadata via the GitHub API
      - { host: api.github.com, port: 443 }
      - { host: downloads.python.org, port: 443 }
    binaries:
      - { path: /sandbox/.venv/bin/python }
      - { path: /sandbox/.venv/bin/python3 }
      - { path: /sandbox/.venv/bin/pip }
      - { path: /app/.venv/bin/python }
      - { path: /app/.venv/bin/python3 }
      - { path: /app/.venv/bin/pip }
      - { path: /usr/local/bin/uv }
      # Managed Python installations from uv python install
      - { path: "/sandbox/.uv/python/**" }

  vscode:
    name: vscode
    endpoints:
      - { host: update.code.visualstudio.com, port: 443 }
      # NOTE: OPA host matching uses exact equality, not glob — list hosts explicitly.
      - { host: az764295.vo.msecnd.net, port: 443 }
      - { host: vscode.download.prss.microsoft.com, port: 443 }
      - { host: marketplace.visualstudio.com, port: 443 }
      - { host: gallerycdn.vsassets.io, port: 443 }
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/wget }
      - { path: "/sandbox/.vscode-server/**" }
      - { path: "/sandbox/.vscode-remote-containers/**" }

  cursor:
    name: cursor
    endpoints:
      - { host: cursor.blob.core.windows.net, port: 443 }
      # NOTE: OPA host matching uses exact equality, not glob — list hosts explicitly.
      - { host: api2.cursor.sh, port: 443 }
      - { host: repo.cursor.sh, port: 443 }
      - { host: download.cursor.sh, port: 443 }
      - { host: cursor.download.prss.microsoft.com, port: 443 }
    binaries:
      - { path: /usr/bin/curl }
      - { path: /usr/bin/wget }
      - { path: "/sandbox/.cursor-server/**" }

  opencode:
    name: opencode
    endpoints:
    - host: registry.npmjs.org
      port: 443
    - host: opencode.ai
      port: 443
    - host: integrate.api.nvidia.com
      port: 443
    binaries:
    - path: /usr/lib/node_modules/opencode-ai/bin/.opencode
    - path: /usr/bin/node
    - path: /usr/local/bin/opencode

  codex:
    name: codex
    endpoints:
      - { host: api.openai.com,  port: 443 }
      - { host: auth.openai.com, port: 443 }
      - { host: chatgpt.com,     port: 443 }
    binaries:
      - { path: /usr/bin/codex }
      - { path: /usr/bin/node }
      - { path: "/usr/lib/node_modules/@openai/**" }
KOMORA_POLICY_EOF
}

main() {
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) KOMORA_DRY_RUN=1; shift ;;
      --source-only) return 0 ;;
      # Print the embedded egress policy and exit — the re-vendor seam (#31).
      # Diff `komora --render-policy` against a fresh image copy to re-vendor;
      # the byte-identity test asserts it matches the checked-in fixture.
      --render-policy) render_policy; return 0 ;;
      --cwd)
        [[ $# -ge 2 ]] || { echo "komora: --cwd requires a directory argument" >&2; exit 2; }
        KOMORA_CWD="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done

  set -- "${args[@]+"${args[@]}"}"

  local command="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  case "$command" in
    run)   cmd_run "$@" ;;
    ls)    cmd_ls "$@" ;;
    stop)  cmd_stop "$@" ;;
    rm)    cmd_rm "$@" ;;
    shell) cmd_shell "$@" ;;
    id)    cmd_id "$@" ;;
    -h|--help) usage; exit 0 ;;
    "")    cmd_run ;;
    *)
      # A bare `owner/repo` with no subcommand also means `run` (#18, user
      # story 1: zero-ceremony launch).
      if [[ "$command" == */* ]]; then
        cmd_run "$command" "$@"
      else
        echo "komora: unknown command '$command'" >&2
        usage
        exit 2
      fi
      ;;
  esac
}

main "$@"
