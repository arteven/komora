#!/usr/bin/env bash
# komora: a thin wrapper around the openshell CLI. Scaffold: #15. Spec: #14.
set -euo pipefail

KOMORA_DRY_RUN=0
KOMORA_CWD="$PWD"
KOMORA_IMAGE="${KOMORA_IMAGE:-ghcr.io/nvidia/openshell-community/sandboxes/base:latest}"
KOMORA_PROFILE="${KOMORA_PROFILE:-default}"

usage() {
  cat >&2 <<'EOF'
usage: komora [--dry-run] [--cwd DIR] <command> [args...]

commands:
  ls          list komora sandboxes and volumes
  stop        stop a running sandbox
  rm          remove a sandbox (or, with intent, a volume)
  shell       open a shell in the sandbox instead of the agent
  id [owner/repo]
              resolve and print the repo id and slug this invocation means
  volumes <slug> [profile]
              create and prime the repo and profile volumes

  --dry-run   print podman/openshell invocations instead of running them
EOF
}

# --- the dry-run seam: every external invocation goes through `plan`, which
# either prints the command (one per line, args in call order) or execs it.
# This is the seam every later ticket's tests assert against (#14).
plan() {
  if [[ "$KOMORA_DRY_RUN" -eq 1 ]]; then
    local line="" arg
    for arg in "$@"; do
      printf -v arg '%q' "$arg"  # shell-quote in place, not append
      line+="${line:+ }${arg}"
    done
    printf '%s\n' "$line"
  else
    "$@"
  fi
}

# Maps an owner/repo (or any string) to a Podman/OpenShell-safe volume slug:
# lowercase, [a-z0-9-] only. Not injective by design (#14, #16) — collision
# detection against existing volumes is the caller's job, not this function's.
slugify() {
  local s="${1,,}"
  s="${s//[^a-z0-9]/-}"
  printf '%s' "$s"
}

cmd_ls() {
  plan podman volume ls --filter "label=komora"
  plan podman ps --all --filter "label=komora"
}

# Reads the sandbox user's uid out of the image's own /etc/passwd at run time
# (#14, #17). Never hardcoded: it is 998 in the current community base image
# and would differ in a custom one. `--entrypoint sh` is required — the image's
# own entrypoint is /bin/bash, which would otherwise swallow "sh" as its argv
# rather than exec it.
resolve_sandbox_uid() {
  podman run --rm --entrypoint sh "$KOMORA_IMAGE" -c 'getent passwd sandbox | cut -d: -f3'
}

# Creates a named volume if it does not already exist. `podman volume create`
# is not itself idempotent — it errors on an existing name — so existence is
# checked first (#17 acceptance: creating is idempotent).
ensure_volume() {
  local vol="$1"; shift
  podman volume exists "$vol" 2>/dev/null && return 0
  plan podman volume create "$@" "$vol"
}

# Primes a volume so the sandbox uid can write it. Podman's first-mount
# auto-chown of an empty named volume targets container root, not the sandbox
# uid OpenShell's supervisor setuid()s down to — so an unprimed volume mounts
# but is not writable by the agent. Priming must *write* as that uid; a run
# that only mounts does not trigger the chown (#14, #17). Idempotent: touching
# an existing .keep neither errors nor destroys other content in the volume.
prime_volume() {
  local vol="$1" uid="$2"
  plan podman run --rm --user "${uid}:${uid}" --entrypoint sh \
    -v "${vol}:/x" "$KOMORA_IMAGE" -c 'touch /x/.keep'
}

# Creates and primes both persistent volumes for a repo slug + profile name:
# komora-repo-<slug> (clone + working state) and komora-profile-<name>
# (credential, MCP OAuth tokens, session history) (#14, #17).
cmd_volumes() {
  local slug="${1:?komora: volumes requires a repo slug}"
  local profile="${2:-$KOMORA_PROFILE}"
  local repo_vol="komora-repo-${slug}"
  local profile_vol="komora-profile-${profile}"

  local uid; uid="$(resolve_sandbox_uid)"

  ensure_volume "$repo_vol" --label "komora" --label "komora.repo=${slug}"
  ensure_volume "$profile_vol" --label "komora" --label "komora.profile=${profile}"

  prime_volume "$repo_vol" "$uid"
  prime_volume "$profile_vol" "$uid"

  echo "repo volume: $repo_vol"
  echo "profile volume: $profile_vol"
}

cmd_stop() {
  echo "komora: stop not yet implemented" >&2
  return 1
}

cmd_rm() {
  echo "komora: rm not yet implemented" >&2
  return 1
}

cmd_shell() {
  echo "komora: shell not yet implemented" >&2
  return 1
}

# Parses an `origin` remote URL into owner/repo. Handles both forms git
# actually produces: SSH shorthand (git@host:owner/repo.git) and HTTPS
# (https://host/owner/repo.git), with an optional trailing ".git" (#16).
parse_remote_url() {
  local url="$1" path
  case "$url" in
    git@*:*)   path="${url#*:}" ;;
    https://*) path="${url#https://*/}" ;;
    http://*)  path="${url#http://*/}" ;;
    *) return 1 ;;
  esac
  path="${path%.git}"
  path="${path%/}"
  [[ "$path" == */* ]] || return 1
  printf '%s' "$path"
}

# Derives owner/repo from `git remote get-url origin` in KOMORA_CWD, if that
# directory is inside a clone with an origin remote.
derive_repo_id() {
  local url
  url="$(git -C "$KOMORA_CWD" remote get-url origin 2>/dev/null)" || return 1
  parse_remote_url "$url"
}

# Reads the owner/repo recorded on an existing repo volume's komora.repo
# label, if that volume exists. Empty output (not failure) if it doesn't —
# "no volume yet" and "lookup error" are both "nothing to collide with".
existing_volume_repo() {
  local vol="$1"
  podman volume inspect --format '{{ index .Labels "komora.repo" }}' "$vol" 2>/dev/null || true
}

# Refuses a slug collision: two different owner/repo values that slug to the
# same volume name would otherwise silently share one repo volume (#14, #16).
check_slug_collision() {
  local repo_id="$1" slug="$2"
  local vol="komora-repo-${slug}"
  local existing; existing="$(existing_volume_repo "$vol")"

  if [[ -n "$existing" && "$existing" != "$repo_id" ]]; then
    echo "komora: slug collision on '$slug'" >&2
    echo "  '$repo_id' and '$existing' both slug to '$slug'" >&2
    echo "  refusing to share the same volume between different repos" >&2
    return 1
  fi
}

# Resolves the repo id (owner/repo) this invocation means: a positional
# argument if given, else derived from `git remote get-url origin` (#16).
cmd_id() {
  local repo_id="${1:-}"

  if [[ -z "$repo_id" ]]; then
    repo_id="$(derive_repo_id)" || {
      echo "komora: no repo given and not in a host clone" >&2
      echo "  pass an explicit owner/repo, or run inside a clone with an 'origin' remote" >&2
      return 1
    }
  fi

  local slug; slug="$(slugify "$repo_id")"
  check_slug_collision "$repo_id" "$slug" || return 1

  echo "repo: $repo_id"
  echo "slug: $slug"
}

main() {
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) KOMORA_DRY_RUN=1; shift ;;
      --source-only) return 0 ;;
      --cwd)
        [[ $# -ge 2 ]] || { echo "komora: --cwd requires a directory argument" >&2; exit 2; }
        KOMORA_CWD="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done

  set -- "${args[@]+"${args[@]}"}"

  local command="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  case "$command" in
    ls)    cmd_ls "$@" ;;
    stop)  cmd_stop "$@" ;;
    rm)    cmd_rm "$@" ;;
    shell) cmd_shell "$@" ;;
    id)    cmd_id "$@" ;;
    volumes) cmd_volumes "$@" ;;
    -h|--help|"") usage; [[ "$command" == "" ]] && exit 2 || exit 0 ;;
    *)
      echo "komora: unknown command '$command'" >&2
      usage
      exit 2
      ;;
  esac
}

main "$@"
