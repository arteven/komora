{
  "name": "komora",
  "version": "0.1.0",
  "description": "Per-workspace microVM sandboxes for AI coding agents.",
  "type": "module",
  "bin": {
    "komora": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p . && node -e \"require('node:fs').cpSync('src/toolchains','dist/toolchains',{recursive:true,filter:(s)=>s.endsWith('.sh')||require('node:fs').statSync(s).isDirectory()})\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . --noEmit",
    "lint": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "microsandbox": "^0.4.2",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "files": [
    "dist/",
    "src/toolchains/",
    "schema/"
  ]
}
